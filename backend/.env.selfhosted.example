# Production environment for the SELF-HOSTED deployment (HomeServer).
# Copy to the server's secrets location (root-only, 0600). Never commit real values.
# See docs/self-hosted.md for what each setting does and how to obtain it.

APP_ENV=production
APP_TIMEZONE=Europe/Lisbon
API_DOCS_ENABLED=false

# Postgres on the private apps_db network (no published port).
DATABASE_URL=postgresql://finance_app:CHANGE_ME@postgres:5432/finance?sslmode=disable

# The exact origin the browser uses (the app's tailnet name). No trailing slash.
CORS_ORIGINS=https://finance.CHANGE_ME.ts.net
LOCAL_NETWORK_ONLY=false

# Sign-in: Google ID token -> the API's own session token.
AUTH_MODE=google
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARS
SESSION_TTL_HOURS=720

# Who may use the app, and who may maintain shared market data.
ALLOWED_USER_EMAILS=you@example.com
ADMIN_USER_EMAILS=you@example.com

# Pin each person to the user id their existing rows carry (see docs/self-hosted.md).
AUTH_USER_ID_MAP=you@example.com=00000000-0000-0000-0000-000000000000

# Optional: pending sign-up notification email (leave unset to disable).
# RESEND_API_KEY=
# ADMIN_NOTIFICATION_EMAIL=

# Not used when AUTH_MODE=google (leave unset):
#   SUPABASE_URL, SUPABASE_JWKS_URL, SUPABASE_JWT_SECRET, SUPABASE_SERVICE_ROLE_KEY
