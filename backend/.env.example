# See docs/deployment.md for the full environment variable reference and a
# local setup. Production values live in backend/.env.selfhosted.example.

# --- Database ---
# Omit for local SQLite (defaults to backend/data/finance.db).
# Required in production (APP_ENV=production).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Sign-in (Google ID token -> this API's own session token) ---
# Required in production. See docs/auth-options.md.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# At least 32 characters; signs the session tokens (openssl rand -hex 32).
# SESSION_SECRET=
# SESSION_TTL_HOURS=720
# Pin an email to the user id its rows already carry (email=user-id,...).
# AUTH_USER_ID_MAP=

# --- Authorization ---
# Required in production. Comma-separated emails.
# ALLOWED_USER_EMAILS=you@example.com
# ADMIN_USER_EMAILS=you@example.com

# --- Sign-up notifications (optional) ---
# Sends an email via Resend (https://resend.com) when someone new signs in
# with Google and is waiting for approval in Settings. If either is unset,
# the pending sign-up is still recorded and visible in Settings - only the
# email notification is skipped.
# RESEND_API_KEY=re_your_key_here
# ADMIN_NOTIFICATION_EMAIL=you@example.com

# --- CORS ---
# Comma-separated origins. Defaults to the local Vite dev server if unset.
# Must not contain * in production.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- App environment ---
# development (default) or production. Production enables stricter
# validation - see app/config.py:validate_production_config.
# APP_ENV=development

# Optional deployment provenance shown by GET /api/health.
# The release build sets this to the release git commit.
# APP_GIT_COMMIT=

# Defaults to false locally; must be false in production.
# LOCAL_NETWORK_ONLY=false

# Defaults to enabled outside production, disabled in production.
# API_DOCS_ENABLED=true

# --- Operational timeout policy ---
MARKET_DATA_TIMEOUT_SECONDS=15
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
