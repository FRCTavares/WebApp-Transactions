# Backend API URL used by the frontend.
# For normal Mac-only local use:
VITE_API_BASE_URL=http://localhost:8000

# For iPhone testing on the same Wi-Fi, replace the IP with your Mac local IP:
# VITE_API_BASE_URL=http://192.168.1.50:8000

# Google Identity Services client id (public). Sign-in is verified once by the
# API, which then issues its own session; see docs/auth-options.md and
# docs/deployment.md#local-development for a local setup that needs no Google account.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Shown on the Privacy page as the contact for privacy requests. Public value,
# no credentials. Defaults to "the deployment owner" if unset.
VITE_PRIVACY_CONTACT_EMAIL=you@example.com
